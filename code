import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.Random;


public class Maze {
    private final int rows;
    private final int cols;
    private int[][] grid;

    public Maze(int rows, int cols) {
        this.rows = rows;
        this.cols = cols;
        this.grid = new int[rows][cols];
    }

    private Random random = new Random();
    private final int[][] directions = {{-1, 0}, {0, 1}, {1, 0}, {0, -1}};

    public void generateMaze() {
        for (int[] row : grid) {
            Arrays.fill(row, 1);
        }
        carvePath(1, 1);
    }

    private void carvePath(int row, int col) {
        grid[row][col] = 0;
        List<Integer> dirs = Arrays.asList(0, 1, 2, 3);
        Collections.shuffle(dirs);

        for (int dir : dirs) {
            int newRow = row + directions[dir][0] * 2;
            int newCol = col + directions[dir][1] * 2;

            if (newRow > 0 && newRow < rows - 1 && newCol > 0 && newCol < cols - 1 && grid[newRow][newCol] == 1) {
                grid[row + directions[dir][0]][col + directions[dir][1]] = 0;
                carvePath(newRow, newCol);
            }
        }
    }

    private void connectToExit() {
        boolean[][] visited = new boolean[rows][cols];
        Stack<int[]> stack = new Stack<>();
        stack.push(new int[]{1, 1});
        visited[1][1] = true;
    
        while (!stack.isEmpty()) {
            int[] current = stack.pop();
            int row = current[0], col = current[1];
    
            if (row == rows - 2 && col == cols - 2) return;
    
            for (int[] dir : directions) {
                int newRow = row + dir[0];
                int newCol = col + dir[1];
    
                if (newRow >= 0 && newRow < rows && newCol >= 0 && newCol < cols
                        && grid[newRow][newCol] == 0 && !visited[newRow][newCol]) {
                    visited[newRow][newCol] = true;
                    stack.push(new int[]{newRow, newCol});
                }
            }
        }
    
        grid[rows - 2][cols - 2] = 0;
        grid[rows - 3][cols - 2] = 0;
    }

    private boolean[][] visited;
    private List<int[]> path;
    
    public boolean solveMaze() {
        visited = new boolean[rows][cols];
        path = new ArrayList<>();
        return solve(1, 1);
    }
    
    private boolean solve(int row, int col) {
        if (row < 0 || row >= rows || col < 0 || col >= cols || grid[row][col] == 1 || visited[row][col])
            return false;
    
        if (row == rows - 2 && col == cols - 2) {
            path.add(new int[]{row, col});
            return true;
        }
    
        visited[row][col] = true;
        path.add(new int[]{row, col});
    
        for (int[] dir : directions) {
            if (solve(row + dir[0], col + dir[1])) return true;
        }
    
        path.remove(path.size() - 1);
        return false;
    }


}
